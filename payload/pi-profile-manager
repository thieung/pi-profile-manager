verify_pi_profile() {
  local profile="$1"
  local root
  local wrapper="$HOME/.local/bin/$profile"
  local packages
  local extension=""
  root="$(pi_root "$profile")"

  [[ -x "$wrapper" ]] || fail "missing executable wrapper: $wrapper"
  assert_pi_profile_root "$profile"
  packages="$("$wrapper" list)"
  for extension in "${PI_EXTENSIONS[@]}"; do
    grep -F "$extension" <<<"$packages" >/dev/null \
      || fail "$profile missing extension: $extension"
  done
  grep -F "$root/npm/node_modules" <<<"$packages" >/dev/null \
    || fail "$profile package list does not point to its profile root"

  if [[ "$profile" == "pi-ak" ]]; then
    [[ -f "$root/extensions/agentkit-hooks-engineer/.agentkit/install-manifest.json" ]] \
      || fail "pi-ak missing AgentKit install manifest"
  fi
  info "$profile verification passed"
}

verify_omp_profile() {
  local profile="${1:-pi-omp}"
  local root
  local wrapper="$HOME/.local/bin/$profile"
  local runtime_root
  root="$(omp_root "$profile")"

  [[ -x "$wrapper" ]] || fail "missing executable wrapper: $wrapper"
  assert_omp_profile_root "$profile"
  runtime_root="$("$wrapper" config path)"
  [[ "$runtime_root" == "$root" ]] \
    || fail "$profile config path '$runtime_root'; expected '$root'"
  if [[ "$profile" == "pi-omp" || -f "$root/.agentkit-profile" ]]; then
    omp_agentkit_check "$profile" >/dev/null
  elif [[ -d "$root/skills" ]] && compgen -G "$root/skills/ak-*/SKILL.md" >/dev/null 2>&1; then
    omp_agentkit_check "$profile" >/dev/null
  fi
  info "$profile verification passed"
}
verify_target() {
  local target="$1"
  require_command mise
  case "$target" in
    pi-dev)
      verify_pi_profile pi-dev
      ;;
    pi-ak)
      verify_pi_profile pi-ak
      ;;
    pi-omp)
      verify_omp_profile pi-omp
      ;;
    all)
      verify_pi_profile pi-dev
      verify_pi_profile pi-ak
      verify_omp_profile pi-omp
      ;;
    *)
      validate_profile_name "$target"
      local config_path="$HOME/.config/mise/config.${target}.toml"
      local wrapper_path="$HOME/.local/bin/${target}"
      if [[ -f "$config_path" || -x "$wrapper_path" ]]; then
        if [[ -f "$config_path" ]] && grep -F -- "OMP_PROFILE = \"$target\"" "$config_path" >/dev/null 2>&1; then
          verify_omp_profile "$target"
        elif [[ -f "$config_path" ]] && grep -F -- "OMP_PROFILE =" "$config_path" >/dev/null 2>&1; then
          verify_omp_profile "$target"
        elif [[ -f "$config_path" ]] && grep -F -- 'PI_CODING_AGENT_DIR = "' "$config_path" >/dev/null 2>&1; then
          verify_pi_profile "$target"
        else
          verify_omp_profile "$target"
        fi
      else
        fail "unknown verify target: $target"
      fi
  esac
}

validate_profile_name() {
  local name="$1"
  local lower=""
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || fail "invalid profile name: $name"
  lower="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    all|pi|omp|doctor|update|install|verify|bootstrap|add|list|profiles|profile|help|pi-dev|pi-ak|pi-omp)
      fail "reserved profile name: $name"
      ;;
  esac
}

cmd_add() {
  local profile_name=""
  local auth_type=""
  local broker_url=""
  local broker_token=""
  local with_agentkit=""
  local root=""
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --auth)
        [[ "$#" -ge 2 ]] || fail "--auth requires a value (broker or local)"
        auth_type="$2"
        shift 2
        ;;
      --broker-url)
        [[ "$#" -ge 2 ]] || fail "--broker-url requires a value"
        broker_url="$2"
        shift 2
        ;;
      --broker-token)
        [[ "$#" -ge 2 ]] || fail "--broker-token requires a value"
        broker_token="$2"
        shift 2
        ;;
      --with-agentkit)
        with_agentkit="1"
        shift
        ;;
      --no-agentkit)
        with_agentkit="0"
        shift
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      -*)
        fail "unknown option: $1"
        ;;
      *)
        if [[ -z "$profile_name" ]]; then
          profile_name="$1"
          shift
        else
          fail "unexpected argument: $1"
        fi
        ;;
    esac
  done

  if [[ -z "$profile_name" ]]; then
    if [[ -t 0 ]]; then
      printf 'Profile name: '
      read -r profile_name
    else
      fail "add requires a profile name"
    fi
  fi
  validate_profile_name "$profile_name"
  root="$(omp_root "$profile_name")"
  if [[ -z "$auth_type" ]]; then
    if [[ -t 0 ]]; then
      printf 'Select authentication mode:\n'
      printf '  1) OMP Auth Broker (OMP_AUTH_BROKER_URL + OMP_AUTH_BROKER_TOKEN)\n'
      printf '  2) Local (standalone credentials / agent.db)\n'
      printf 'Choice [1-2]: '
      local choice=""
      read -r choice
      case "$choice" in
        1|broker|"omp auth broker"|"auth broker")
          auth_type="broker"
          ;;
        2|local)
          auth_type="local"
          ;;
        *)
          fail "invalid authentication choice: $choice"
          ;;
      esac
    else
      fail "--auth is required in non-interactive mode (broker or local)"
    fi
  fi

  case "$auth_type" in
    broker|omp-auth-broker|"omp auth broker")
      auth_type="broker"
      ;;
    local)
      auth_type="local"
      ;;
    *)
      fail "invalid auth type: $auth_type (expected 'broker' or 'local')"
      ;;
  esac

  if [[ "$auth_type" == "broker" ]]; then
    if [[ -z "$broker_url" ]]; then
      if [[ -t 0 ]]; then
        printf 'Enter OMP_AUTH_BROKER_URL: '
        read -r broker_url
      else
        fail "--broker-url is required when using broker authentication"
      fi
    fi
    [[ -n "$broker_url" ]] || fail "OMP_AUTH_BROKER_URL cannot be empty"
    validate_env_value "OMP_AUTH_BROKER_URL" "$broker_url"

    if [[ -z "$broker_token" ]]; then
      if [[ -t 0 ]]; then
        printf 'Enter OMP_AUTH_BROKER_TOKEN: '
        read -r -s broker_token
        printf '\n'
      else
        fail "--broker-token is required when using broker authentication"
      fi
    fi
    [[ -n "$broker_token" ]] || fail "OMP_AUTH_BROKER_TOKEN cannot be empty"
    validate_env_value "OMP_AUTH_BROKER_TOKEN" "$broker_token"
  fi

  if [[ -z "$with_agentkit" ]]; then
    if [[ -t 0 ]]; then
      printf 'Install AgentKit into this profile? [y/N]: '
      local ak_choice=""
      read -r ak_choice
      case "$ak_choice" in
        y|Y|yes|YES)
          with_agentkit="1"
          ;;
        *)
          with_agentkit="0"
          ;;
      esac
    else
      with_agentkit="0"
    fi
  fi

  require_command mise
  if [[ "$with_agentkit" == "1" ]]; then
    require_command ak
  fi

  local config_path="$HOME/.config/mise/config.${profile_name}.toml"
  local wrapper_path="$HOME/.local/bin/${profile_name}"
  local env_path="$root/.env"
  local marker_path="$root/.manager-profile"
  local ak_marker_path="$root/.agentkit-profile"
  assert_managed_config_writable "$config_path" "$profile_name"
  assert_managed_wrapper_writable "$wrapper_path" "$profile_name" omp
  if [[ -e "$env_path" || -L "$env_path" ]]; then
    [[ ! -L "$env_path" && -f "$env_path" ]] || fail "managed target is not a regular file: $env_path"
    local first_line=""
    IFS= read -r first_line <"$env_path" || true
    if [[ "$first_line" != "# $MANAGED_MARKER" ]]; then
      if [[ "$auth_type" == "broker" ]]; then
        fail "refusing to overwrite user-owned file without managed marker: $env_path"
      else
        fail "refusing to remove user-owned file without managed marker: $env_path"
      fi
    fi
  fi
  assert_managed_marker_file_writable "$marker_path"
  if [[ "$with_agentkit" == "1" ]]; then
    assert_managed_marker_file_writable "$ak_marker_path"
  fi
  assert_target_writable "$config_path"
  assert_target_writable "$wrapper_path"
  assert_target_writable "$marker_path"
  if [[ "$auth_type" == "broker" || -e "$env_path" || -L "$env_path" ]]; then
    assert_target_writable "$env_path"
  fi
  if [[ "$with_agentkit" == "1" ]]; then
    assert_target_writable "$ak_marker_path"
  fi

  ensure_omp_profile "$profile_name"
  assert_omp_profile_root "$profile_name"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    write_managed_file "$marker_path" "$(printf '# %s\n' "$MANAGED_MARKER")"
  fi

  if [[ "$auth_type" == "broker" ]]; then
    write_broker_env "$profile_name" "$broker_url" "$broker_token"
  else
    if [[ -e "$env_path" ]]; then
      if [[ "$DRY_RUN" -eq 1 ]]; then
        info "would remove broker env: $env_path"
      else
        rm -f "$env_path"
        info "removed broker env: $env_path"
      fi
    fi
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    info "would verify or install OMP runtime for $profile_name"
    if [[ "$with_agentkit" == "1" ]]; then
      info "would install AgentKit for $profile_name"
      write_managed_file "$ak_marker_path" "$(printf '# %s\n' "$MANAGED_MARKER")"
    fi
  else
    local omp_version=""
    if command -v omp >/dev/null 2>&1; then
      omp_version="$(mise -E "$profile_name" exec -- omp --version)" \
        || fail "failed to verify existing OMP in $profile_name: omp --version failed"
      info "OMP verified: $omp_version"
    else
      install_omp_binary latest "$profile_name"
    fi
    if [[ "$with_agentkit" == "1" ]]; then
      install_agentkit "$profile_name" omp
      write_managed_file "$ak_marker_path" "$(printf '# %s\n' "$MANAGED_MARKER")"
    fi
  fi
  info "profile ready: $profile_name ($auth_type)"
  info "run: $profile_name"
  if [[ "$auth_type" == "broker" ]]; then
    info "verify connection: $profile_name auth-broker status"
  fi
}

doctor() {
  local failures=0
  local command_name=""
  for command_name in mise npm; do
    if command -v "$command_name" >/dev/null 2>&1; then
      info "$command_name: $(command -v "$command_name")"
    else
      warn "missing prerequisite: $command_name"
      failures=$((failures + 1))
    fi
  done

  for command_name in pi omp ak; do
    if command -v "$command_name" >/dev/null 2>&1; then
      info "$command_name: $(command -v "$command_name")"
    else
      warn "optional until its profile is installed: $command_name"
    fi
  done

  case ":$PATH:" in
    *":$HOME/.local/bin:"*) info "wrapper PATH configured: $HOME/.local/bin" ;;
    *) warn "$HOME/.local/bin is not currently in PATH" ;;
  esac

  [[ "$failures" -eq 0 ]] || fail "doctor found $failures missing prerequisite(s)"
  info "doctor passed"
}

parse_options() {
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      --version)
        [[ "$#" -ge 2 ]] || fail "--version requires a value"
        REQUESTED_VERSION="$2"
        validate_version "$REQUESTED_VERSION"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        fail "unknown option: $1"
        ;;
    esac
  done
}

main() {
  local command="${1:-}"
  local target=""
  [[ -n "$command" ]] || {
    usage
    exit 1
  }
  shift || true

  case "$command" in
    bootstrap)
      parse_options "$@"
      [[ "$REQUESTED_VERSION" == "latest" ]] \
        || fail "bootstrap does not accept --version"
      bootstrap_mise
      ;;
    doctor)
      [[ "$#" -eq 0 ]] || fail "doctor does not accept arguments"
      doctor
      ;;
    install)
      target="${1:-}"
      [[ -n "$target" ]] || fail "install requires a profile or all"
      shift
      parse_options "$@"
      [[ "$REQUESTED_VERSION" == "latest" ]] \
        || fail "--version is supported only by update"
      install_target "$target"
      ;;
    update)
      target="${1:-}"
      [[ -n "$target" ]] || fail "update requires pi, omp, or all"
      shift
      parse_options "$@"
      update_target "$target"
      ;;
    add)
      cmd_add "$@"
      ;;
    profiles|profile)
      target="${1:-}"
      if [[ "$target" == "list" ]]; then
        shift
        [[ "${1:-}" == "--json" && "$#" -eq 1 ]] || fail "$command list requires --json"
        profiles_list_json
      elif [[ "$target" == "add" ]]; then
        shift
        cmd_add "$@"
      else
        fail "$command requires: list --json or add"
      fi
      ;;
    verify)
      target="${1:-all}"
      [[ "$#" -le 1 ]] || fail "verify accepts at most one target"
      verify_target "$target"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      usage >&2
      fail "unknown command: $command"
      ;;
  esac
}

main "$@"
