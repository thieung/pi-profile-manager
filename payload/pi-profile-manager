#!/usr/bin/env bash
set -euo pipefail

PROGRAM_NAME="pi-profile-manager"
PI_PACKAGE="@earendil-works/pi-coding-agent"
OMP_TOOL="github:can1357/oh-my-pi"
MISE_INSTALLER_URL="https://mise.run"
DRY_RUN=0
REQUESTED_VERSION="latest"
MANAGED_MARKER="managed by pi-profile-manager"

PI_EXTENSIONS=(
  "npm:statusline-pi@1.2.1"
  "npm:advisor-pi@1.0.3"
  "npm:grok-pi@1.2.0"
  "npm:model-debugger@1.0.2"
  "npm:@tintinweb/pi-subagents@0.18.0"
)

usage() {
  cat <<'USAGE'
Usage:
  pi-profile-manager bootstrap [--dry-run]
  pi-profile-manager doctor
  pi-profile-manager install <pi-dev|pi-ak|pi-omp|all> [--dry-run]
  pi-profile-manager add [name] [--auth <broker|local>] [--broker-url <url>] [--broker-token <token>] [--with-agentkit|--no-agentkit] [--dry-run]
  pi-profile-manager update <pi|omp|all> [--version <exact>] [--dry-run]
  pi-profile-manager profiles list --json
  pi-profile-manager verify [pi-dev|pi-ak|pi-omp|<custom>|all]

The script never reads or writes provider credentials. AgentKit is invoked only
for pi-ak, pi-omp, or profiles configured with AgentKit. Bootstrap installs only Mise;
Node.js/npm and AgentKit stay explicit prerequisites. Use --dry-run to preview
filesystem and command mutations.
USAGE
}

info() {
  printf 'INFO: %s\n' "$*"
}

warn() {
  printf 'WARN: %s\n' "$*" >&2
}

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

print_command() {
  printf 'RUN:'
  printf ' %q' "$@"
  printf '\n'
}

run_command() {
  print_command "$@"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    "$@"
  fi
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"
}

validate_version() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] \
    || fail "invalid version: $1"
}

timestamp() {
  date '+%Y%m%d-%H%M%S'
}

bootstrap_mise() {
  local install_path="$HOME/.local/bin/mise"
  local installer=""
  local staging_dir=""
  local staged_mise=""
  local mise_version=""

  if command -v mise >/dev/null 2>&1; then
    info "mise already available: $(command -v mise)"
    info "mise version: $(mise --version)"
    return
  fi

  if [[ -x "$install_path" ]]; then
    info "mise already installed: $install_path"
    info "mise version: $("$install_path" --version)"
    warn "$HOME/.local/bin is not currently in PATH"
    info "add to PATH: export PATH=\"$HOME/.local/bin:\$PATH\""
    return
  fi

  if [[ -e "$install_path" ]]; then
    fail "refusing to replace non-executable Mise path: $install_path"
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    info "would download official Mise installer: $MISE_INSTALLER_URL"
    info "would install Mise: $install_path"
    info "would verify: $install_path --version"
    return
  fi

  require_command curl
  require_command sh
  mkdir -p "$HOME/.local/bin"
  if ! installer="$(mktemp "${TMPDIR:-/tmp}/pi-profile-manager-mise.XXXXXX")"; then
    fail "failed to create temporary Mise installer"
  fi
  if ! staging_dir="$(mktemp -d "$HOME/.local/bin/.mise-stage.XXXXXX")"; then
    rm -f "$installer"
    fail "failed to create Mise staging directory"
  fi
  staged_mise="$staging_dir/mise"

  print_command curl --proto '=https' --tlsv1.2 --fail --silent \
    --show-error --location --output "$installer" "$MISE_INSTALLER_URL"
  if ! curl --proto '=https' --tlsv1.2 --fail --silent \
    --show-error --location --output "$installer" "$MISE_INSTALLER_URL"; then
    rm -f "$installer" "$staged_mise"
    rmdir "$staging_dir" 2>/dev/null || true
    fail "failed to download official Mise installer"
  fi

  print_command env "MISE_INSTALL_PATH=$staged_mise" \
    MISE_INSTALL_SKIP_IF_EXISTS=1 sh "$installer"
  if ! env "MISE_INSTALL_PATH=$staged_mise" \
    MISE_INSTALL_SKIP_IF_EXISTS=1 sh "$installer"; then
    rm -f "$installer" "$staged_mise"
    rmdir "$staging_dir" 2>/dev/null || true
    fail "official Mise installer failed"
  fi
  rm -f "$installer"

  if [[ ! -x "$staged_mise" ]]; then
    rm -f "$staged_mise"
    rmdir "$staging_dir" 2>/dev/null || true
    fail "Mise installer completed without executable staging binary"
  fi
  if ! mise_version="$("$staged_mise" --version)"; then
    rm -f "$staged_mise"
    rmdir "$staging_dir" 2>/dev/null || true
    fail "staged Mise binary failed verification"
  fi
  if ! mv "$staged_mise" "$install_path"; then
    rm -f "$staged_mise"
    rmdir "$staging_dir" 2>/dev/null || true
    fail "failed to promote staged Mise binary"
  fi
  rmdir "$staging_dir"
  info "mise installed: $install_path"
  info "mise version: $mise_version"
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) info "add to PATH: export PATH=\"$HOME/.local/bin:\$PATH\"" ;;
  esac
}

write_managed_file() {
  local path="$1"
  local content="$2"
  local current=""
  local backup=""

  if [[ -f "$path" ]]; then
    current="$(<"$path")"
    if [[ "$current" == "$content" ]]; then
      info "unchanged: $path"
      return
    fi
    if [[ "$DRY_RUN" -eq 1 ]]; then
      backup="${path}.bak.$(timestamp).XXXXXX"
      info "would back up: $path -> $backup"
    else
      backup="$(mktemp "${path}.bak.$(timestamp).XXXXXX")"
      cp -p "$path" "$backup"
      info "backed up: $path -> $backup"
    fi
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    info "would write: $path"
    return
  fi

  mkdir -p "$(dirname "$path")"
  printf '%s\n' "$content" >"$path"
  info "wrote: $path"
}

legacy_wrapper_content() {
  local profile="$1"
  local executable="$2"
  printf '%s\n' \
    '#!/bin/sh' \
    "exec mise -E ${profile} exec -- ${executable} \"\$@\""
}

assert_managed_wrapper_writable() {
  local path="$1"
  local profile="$2"
  local executable="$3"
  local content=""
  if [[ ! -e "$path" && ! -L "$path" ]]; then
    return 0
  fi
  [[ ! -L "$path" && -f "$path" ]] || fail "managed target is not a regular file: $path"
  content="$(<"$path")"
  [[ "$content" == "$(wrapper_content "$profile" "$executable")" ]] && return
  [[ "$content" == "$(legacy_wrapper_content "$profile" "$executable")" ]] && return
  [[ "$content" == "#!/bin/sh"$'\n'"# $MANAGED_MARKER"$'\n'* ]] && return
  fail "refusing to overwrite user-owned wrapper without managed marker: $path"
}
assert_managed_config_writable() {
  local path="$1"
  local profile="$2"
  local content=""
  local first_line=""
  if [[ ! -e "$path" && ! -L "$path" ]]; then
    return 0
  fi
  [[ ! -L "$path" && -f "$path" ]] || fail "managed target is not a regular file: $path"
  content="$(<"$path")"
  [[ "$content" == "$(omp_config_content "$profile")" ]] && return
  IFS= read -r first_line <<<"$content" || true
  [[ "$first_line" == "# $MANAGED_MARKER" ]] && return
  fail "refusing to overwrite user-owned config without managed marker: $path"
}

assert_managed_marker_file_writable() {
  local path="$1"
  local first_line=""
  if [[ ! -e "$path" && ! -L "$path" ]]; then
    return 0
  fi
  [[ ! -L "$path" && -f "$path" ]] || fail "managed target is not a regular file: $path"
  IFS= read -r first_line <"$path" || true
  [[ "$first_line" == "# $MANAGED_MARKER" ]] && return
  fail "refusing to overwrite user-owned file without managed marker: $path"
}

assert_target_writable() {
  local path="$1"
  local dir=""
  local parent=""
  if [[ -L "$path" ]]; then
    fail "managed target is not a regular file: $path"
  fi
  if [[ -e "$path" ]]; then
    [[ -f "$path" && -w "$path" ]] || fail "managed target is not writable: $path"
  fi
  dir="$(dirname "$path")"
  while [[ ! -e "$dir" ]]; do
    parent="$(dirname "$dir")"
    [[ "$parent" == "$dir" ]] && break
    dir="$parent"
  done
  [[ ! -L "$dir" && -d "$dir" && -w "$dir" && -x "$dir" ]] || fail "managed destination is not writable: $dir"
}

pi_root() {
  printf '%s/.pi/profiles/%s' "$HOME" "$1"
}

omp_root() {
  local profile="${1:-pi-omp}"
  printf '%s/.omp/profiles/%s/agent' "$HOME" "$profile"
}

pi_config_content() {
  local profile="$1"
  printf '%s\n' \
    '[env]' \
    "PI_CODING_AGENT_DIR = \"{{ env.HOME }}/.pi/profiles/${profile}\"" \
    "PI_CODING_AGENT_SESSION_DIR = \"{{ env.HOME }}/.pi/profiles/${profile}/sessions\"" \
    'OMP_PROFILE = false' \
    'PI_PROFILE = false'
}

omp_config_content() {
  local profile="${1:-pi-omp}"
  printf '%s\n' \
    '[env]' \
    "OMP_PROFILE = \"${profile}\"" \
    "AGENTKIT_OMP_HOME = \"{{ env.HOME }}/.omp/profiles/${profile}/agent\"" \
    'PI_PROFILE = false' \
    'PI_CODING_AGENT_DIR = false' \
    'PI_CODING_AGENT_SESSION_DIR = false'
}

validate_env_value() {
  local label="$1"
  local value="$2"
  [[ "$value" != *$'\r'* && "$value" != *$'\n'* ]] \
    || fail "$label cannot contain newline or carriage return"
}

broker_env_content() {
  local url="$1"
  local token="$2"
  printf '%s\n' \
    "# $MANAGED_MARKER" \
    "OMP_AUTH_BROKER_URL=$url" \
    "OMP_AUTH_BROKER_TOKEN=$token"
}

write_broker_env() {
  local profile="$1"
  local url="$2"
  local token="$3"
  local root
  local env_path
  local tmp_path
  local first_line=""

  validate_env_value "OMP_AUTH_BROKER_URL" "$url"
  validate_env_value "OMP_AUTH_BROKER_TOKEN" "$token"

  root="$(omp_root "$profile")"
  env_path="$root/.env"

  if [[ -e "$env_path" || -L "$env_path" ]]; then
    [[ ! -L "$env_path" && -f "$env_path" ]] || fail "managed target is not a regular file: $env_path"
    IFS= read -r first_line <"$env_path" || true
    if [[ "$first_line" != "# $MANAGED_MARKER" ]]; then
      fail "refusing to overwrite user-owned file without managed marker: $env_path"
    fi
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    info "would write: $env_path (mode 0600, token redacted)"
    return
  fi

  mkdir -p "$root"
  tmp_path="$( (umask 077 && mktemp "${env_path}.tmp.XXXXXX") )" \
    || fail "failed to create temporary secret file"

  if ! (
    umask 077
    broker_env_content "$url" "$token" >"$tmp_path"
  ); then
    rm -f "$tmp_path"
    fail "failed to write temporary secret file"
  fi

  chmod 0600 "$tmp_path" 2>/dev/null || true
  if ! mv -f "$tmp_path" "$env_path"; then
    rm -f "$tmp_path"
    fail "failed to replace $env_path"
  fi
  info "wrote: $env_path"
}

wrapper_content() {
  local profile="$1"
  local executable="$2"
  if [[ "$executable" != "pi" ]]; then
    legacy_wrapper_content "$profile" "$executable"
    return
  fi
  cat <<EOF
#!/bin/sh
# $MANAGED_MARKER
case "\${1:-}" in
  install|remove|uninstall|update|list|config|auth)
    exec mise -E ${profile} exec -- pi "\$@"
    ;;
esac
exec mise -E ${profile} exec -- sh -c '
profile_skills="\${PI_CODING_AGENT_DIR%/}/skills"
project_pi="\$PWD/.pi"
has_profile_skill=0
for skill in "\$profile_skills"/*/SKILL.md; do
  if [ -f "\$skill" ]; then
    has_profile_skill=1
    break
  fi
done
if [ -d "\$project_pi" ] || [ "\$has_profile_skill" = 1 ]; then
  if [ -d "\$project_pi/skills" ]; then
    exec pi --no-skills --skill "\$profile_skills" --skill "\$project_pi/skills" "\$@"
  fi
  exec pi --no-skills --skill "\$profile_skills" "\$@"
fi
exec pi "\$@"
' sh "\$@"
EOF
}

ensure_pi_profile() {
  local profile="$1"
  local root
  local config_path="$HOME/.config/mise/config.${profile}.toml"
  local wrapper_path="$HOME/.local/bin/${profile}"
  root="$(pi_root "$profile")"

  assert_managed_wrapper_writable "$wrapper_path" "$profile" pi
  run_command mkdir -p "$root/sessions" "$root/skills" "$HOME/.config/mise" "$HOME/.local/bin"
  write_managed_file "$config_path" "$(pi_config_content "$profile")"
  write_managed_file "$wrapper_path" "$(wrapper_content "$profile" pi)"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    chmod 0755 "$wrapper_path"
  else
    info "would chmod 0755: $wrapper_path"
  fi
}

ensure_omp_profile() {
  local profile="${1:-pi-omp}"
  local root
  local config_path="$HOME/.config/mise/config.${profile}.toml"
  local wrapper_path="$HOME/.local/bin/${profile}"
  root="$(omp_root "$profile")"

  assert_managed_config_writable "$config_path" "$profile"
  assert_managed_wrapper_writable "$wrapper_path" "$profile" omp
  run_command mkdir -p "$root" "$HOME/.config/mise" "$HOME/.local/bin"
  write_managed_file "$config_path" "$(omp_config_content "$profile")"
  write_managed_file "$wrapper_path" "$(wrapper_content "$profile" omp)"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    chmod 0755 "$wrapper_path"
  else
    info "would chmod 0755: $wrapper_path"
  fi
}

assert_pi_profile_root() {
  local profile="$1"
  local expected
  local actual
  expected="$(pi_root "$profile")"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    info "would assert $profile root: $expected"
    return
  fi

  # Expansion is intentionally deferred to the profile-scoped child shell.
  # shellcheck disable=SC2016
  actual="$(mise -E "$profile" exec -- sh -c 'printf %s "$PI_CODING_AGENT_DIR"')"
  [[ "$actual" == "$expected" ]] \
    || fail "$profile resolved root '$actual'; expected '$expected'"
  [[ "$actual" != "$HOME/.pi/agent" ]] \
    || fail "$profile resolved to forbidden default root: $actual"
  info "$profile root verified: $actual"
}

assert_omp_profile_root() {
  local profile="${1:-pi-omp}"
  local expected
  local values
  local actual_root
  local pi_value
  expected="$(omp_root "$profile")"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    info "would assert $profile root: $expected"
    return
  fi

  # Expansion is intentionally deferred to the profile-scoped child shell.
  # shellcheck disable=SC2016
  values="$(mise -E "$profile" exec -- sh -c 'printf "%s\n%s" "$AGENTKIT_OMP_HOME" "${PI_CODING_AGENT_DIR-unset}"')"
  actual_root="${values%%$'\n'*}"
  pi_value="${values#*$'\n'}"
  [[ "$actual_root" == "$expected" ]] \
    || fail "$profile resolved root '$actual_root'; expected '$expected'"
  [[ "$pi_value" == "unset" ]] \
    || fail "$profile unexpectedly inherits PI_CODING_AGENT_DIR='$pi_value'"
  info "$profile root verified: $actual_root"
}

profiles_list_json() {
  require_command node
  PPM_PROFILE_HOME="$HOME" node <<'NODE'
const { spawnSync } = require("node:child_process");
const { existsSync, lstatSync, readdirSync, readFileSync } = require("node:fs");
const { isAbsolute, join, resolve, relative, sep } = require("node:path");

const runtimeEnv = process["env"];
const home = runtimeEnv.PPM_PROFILE_HOME;
const schemaVersion = 1;

function warn(message) {
  process.stderr.write(`WARN: ${message}\n`);
}

function readRegular(path) {
  try {
    const stat = lstatSync(path);
    if (!stat.isFile()) return { exists: true, regular: false, content: "" };
    return { exists: true, regular: true, content: readFileSync(path, "utf8") };
  } catch (error) {
    if (error && error.code === "ENOENT") return { exists: false, regular: false, content: "" };
    throw error;
  }
}

function isDirectory(path) {
  try {
    return lstatSync(path).isDirectory();
  } catch (error) {
    if (error && error.code === "ENOENT") return false;
    throw error;
  }
}

function isExecutableFile(path) {
  try {
    const stat = lstatSync(path);
    return stat.isFile() && (stat.mode & 0o111) !== 0;
  } catch (error) {
    if (error && error.code === "ENOENT") return false;
    throw error;
  }
}

function piRoot(profile) {
  return join(home, ".pi", "profiles", profile);
}

function ompRoot(profile = "pi-omp") {
  return join(home, ".omp", "profiles", profile, "agent");
}

function piConfigContent(profile) {
  return [
    "[env]",
    `PI_CODING_AGENT_DIR = "{{ env.HOME }}/.pi/profiles/${profile}"`,
    `PI_CODING_AGENT_SESSION_DIR = "{{ env.HOME }}/.pi/profiles/${profile}/sessions"`,
    "OMP_PROFILE = false",
    "PI_PROFILE = false",
    "",
  ].join("\n");
}

function ompConfigContent(profile = "pi-omp") {
  return [
    "[env]",
    `OMP_PROFILE = "${profile}"`,
    `AGENTKIT_OMP_HOME = "{{ env.HOME }}/.omp/profiles/${profile}/agent"`,
    "PI_PROFILE = false",
    "PI_CODING_AGENT_DIR = false",
    "PI_CODING_AGENT_SESSION_DIR = false",
    "",
  ].join("\n");
}

function wrapperContent(profile, executable) {
  if (executable !== "pi") {
    return [
      "#!/bin/sh",
      `exec mise -E ${profile} exec -- ${executable} "$@"`,
      "",
    ].join("\n");
  }
  return [
    "#!/bin/sh",
    "# managed by pi-profile-manager",
    'case "${1:-}" in',
    "  install|remove|uninstall|update|list|config|auth)",
    `    exec mise -E ${profile} exec -- pi "$@"`,
    "    ;;",
    "esac",
    `exec mise -E ${profile} exec -- sh -c '`,
    'profile_skills="${PI_CODING_AGENT_DIR%/}/skills"',
    'project_pi="$PWD/.pi"',
    "has_profile_skill=0",
    'for skill in "$profile_skills"/*/SKILL.md; do',
    '  if [ -f "$skill" ]; then',
    "    has_profile_skill=1",
    "    break",
    "  fi",
    "done",
    'if [ -d "$project_pi" ] || [ "$has_profile_skill" = 1 ]; then',
    '  if [ -d "$project_pi/skills" ]; then',
    '    exec pi --no-skills --skill "$profile_skills" --skill "$project_pi/skills" "$@"',
    "  fi",
    '  exec pi --no-skills --skill "$profile_skills" "$@"',
    "fi",
    'exec pi "$@"',
    `' sh "$@"`,
    "",
  ].join("\n");
}

function matchesManagedContent(actual, canonical) {
  return actual === canonical || actual === `${canonical}\n`;
}

function capture(profile, args, label) {
  const result = spawnSync(args[0], args.slice(1), {
    encoding: "utf8",
    env: runtimeEnv,
    stdio: ["ignore", "pipe", "pipe"],
  });
  if (result.error || result.status !== 0) {
    warn(`${profile} ${label} did not resolve`);
    return null;
  }
  return result.stdout.trim();
}

function piRuntimeHealthy(profile, agentDir, sessionDir) {
  const script = 'printf "%s\\n%s" "$PI_CODING_AGENT_DIR" "$PI_CODING_AGENT_SESSION_DIR"';
  const output = capture(profile, ["mise", "-E", profile, "exec", "--", "sh", "-c", script], "runtime environment");
  if (output === null) return false;
  const [actualAgentDir, actualSessionDir] = output.split("\n");
  return resolve(actualAgentDir || "") === resolve(agentDir) &&
    resolve(actualSessionDir || "") === resolve(sessionDir);
}

function ompRuntimeHealthy(agentDir, profile = "pi-omp") {
  const envScript = 'printf "%s\\n%s" "$AGENTKIT_OMP_HOME" "${PI_CODING_AGENT_DIR-unset}"';
  const output = capture(profile, ["mise", "-E", profile, "exec", "--", "sh", "-c", envScript], "runtime environment");
  if (output === null) return false;
  const [actualAgentDir, piValue] = output.split("\n");
  if (resolve(actualAgentDir || "") !== resolve(agentDir) || piValue !== "unset") return false;
  const runtimeRoot = capture(profile, ["mise", "-E", profile, "exec", "--", "omp", "config", "path"], "config path");
  return runtimeRoot !== null && resolve(runtimeRoot) === resolve(agentDir);
}

function readJsonObject(path, profile, label) {
  let stat;
  try {
    stat = lstatSync(path);
  } catch (error) {
    if (error && error.code === "ENOENT") return null;
    throw error;
  }
  if (!stat.isFile()) {
    warn(`${profile} AgentKit ${label} is not a regular file`);
    return null;
  }
  const content = readFileSync(path, "utf8");
  try {
    const value = JSON.parse(content);
    if (!value || Array.isArray(value) || typeof value !== "object") {
      warn(`${profile} AgentKit ${label} is not a JSON object`);
      return null;
    }
    return value;
  } catch {
    warn(`${profile} AgentKit ${label} is invalid`);
    return null;
  }
}

function piAgentKitEnabled(profile, agentDir) {
  const manifest = readJsonObject(
    join(agentDir, "extensions", "agentkit-hooks-engineer", ".agentkit", "install-manifest.json"),
    profile,
    "manifest",
  );
  return Boolean(manifest && manifest.version === 1 && manifest.kit === "engineer" && Array.isArray(manifest.files));
}

function hasAkSkills(root) {
  const skillsRoot = join(root, "skills");
  try {
    return readdirSync(skillsRoot, { withFileTypes: true }).some((entry) =>
      entry.isDirectory() && entry.name.startsWith("ak-") && existsSync(join(skillsRoot, entry.name, "SKILL.md")),
    );
  } catch (error) {
    if (error && error.code === "ENOENT") return false;
    throw error;
  }
}

function isUnderRoot(path, root) {
  const rel = relative(resolve(root), resolve(path));
  return rel === "" || (!isAbsolute(rel) && !rel.startsWith("..") && rel !== ".." && !rel.startsWith(`..${sep}`));
}

function collectStrings(value, output = []) {
  if (typeof value === "string") output.push(value);
  else if (Array.isArray(value)) value.forEach((entry) => collectStrings(entry, output));
  else if (value && typeof value === "object") Object.values(value).forEach((entry) => collectStrings(entry, output));
  return output;
}

function isOmpPathClaim(text) {
  const normalized = String(text).replaceAll("\\", "/");
  return isAbsolute(text) || normalized.includes("/.omp/") || normalized.includes(":/.omp/");
}

function hasWrongOmpClaims(value) {
  if (!value) return false;
  const profilesRoot = join(home, ".omp", "profiles");
  const defaultRoot = join(home, ".omp", "agent");
  for (const text of collectStrings(value)) {
    if (!isOmpPathClaim(text)) continue;
    if (isUnderRoot(text, defaultRoot) || !isUnderRoot(text, profilesRoot)) return true;
  }
  return false;
}

function hasTargetProfileClaim(value, root) {
  if (!value) return false;
  for (const text of collectStrings(value)) {
    if (isOmpPathClaim(text) && isUnderRoot(text, root)) return true;
  }
  return false;
}

function validOwnership(value) {
  return Boolean(value && value.version === 1 && value.kit === "engineer" && Array.isArray(value.claims));
}

function validNativePaths(value) {
  return Boolean(value && Array.isArray(value.skills));
}

function exactManagedFirstLine(content) {
  return String(content).replaceAll("\r\n", "\n").split("\n")[0] === "# managed by pi-profile-manager";
}

function ompClaimsStayInProfile(root, profile = "pi-omp") {
  const ownership = readJsonObject(
    join(home, ".agentkit", "adapters", "omp", "engineer", "omp-ownership.json"),
    profile,
    "ownership",
  );
  const nativePaths = readJsonObject(
    join(home, ".agentkit", "adapters", "omp", "engineer", ".agentkit", "native-skill-paths.json"),
    profile,
    "native skill paths",
  );
  if (!validOwnership(ownership) || !validNativePaths(nativePaths)) return false;
  if (hasWrongOmpClaims(ownership) || hasWrongOmpClaims(nativePaths)) return false;
  return hasTargetProfileClaim(ownership.claims, root) && hasTargetProfileClaim(nativePaths.skills, root);
}

function ompAgentKitEnabled(profile = "pi-omp") {
  const root = ompRoot(profile);
  return hasAkSkills(root) && ompClaimsStayInProfile(root, profile);
}

function piProfile(profile) {
  const agentDir = piRoot(profile);
  const sessionDir = join(agentDir, "sessions");
  const configPath = join(home, ".config", "mise", `config.${profile}.toml`);
  const wrapperPath = join(home, ".local", "bin", profile);
  const config = readRegular(configPath);
  const wrapper = readRegular(wrapperPath);
  if (!config.exists && !wrapper.exists) return null;
  const managed = config.regular && wrapper.regular &&
    matchesManagedContent(config.content, piConfigContent(profile)) &&
    matchesManagedContent(wrapper.content, wrapperContent(profile, "pi"));
  if (!managed) warn(`${profile} managed evidence is incomplete or drifted`);
  const runtimeHealthy = managed && piRuntimeHealthy(profile, agentDir, sessionDir);
  const healthy = managed && isDirectory(agentDir) && isDirectory(sessionDir) &&
    isExecutableFile(wrapperPath) && runtimeHealthy;
  return {
    id: profile,
    runtime: "pi",
    agentDir: resolve(agentDir),
    sessionDir: resolve(sessionDir),
    agentkitEnabled: piAgentKitEnabled(profile, agentDir),
    managed,
    healthy,
  };
}

function ompProfile(profile = "pi-omp") {
  const agentDir = ompRoot(profile);
  const configPath = join(home, ".config", "mise", `config.${profile}.toml`);
  const wrapperPath = join(home, ".local", "bin", profile);
  const config = readRegular(configPath);
  const wrapper = readRegular(wrapperPath);
  if (!config.exists && !wrapper.exists) return null;
  const markerFile = join(agentDir, ".manager-profile");
  let markerOk = profile === "pi-omp";
  if (!markerOk) {
    try {
      const marker = readRegular(markerFile);
      markerOk = marker.exists && marker.regular && exactManagedFirstLine(marker.content);
    } catch {
      markerOk = false;
    }
  }
  const managed = config.regular && wrapper.regular &&
    matchesManagedContent(config.content, ompConfigContent(profile)) &&
    matchesManagedContent(wrapper.content, wrapperContent(profile, "omp")) && markerOk;
  if (!managed) warn(`${profile} managed evidence is incomplete or drifted`);
  const runtimeHealthy = managed && ompRuntimeHealthy(agentDir, profile);
  return {
    id: profile,
    runtime: "omp",
    agentDir: resolve(agentDir),
    sessionDir: null,
    agentkitEnabled: ompAgentKitEnabled(profile),
    managed,
    healthy: managed && isDirectory(agentDir) && isExecutableFile(wrapperPath) && runtimeHealthy,
  };
}
const miseConfigDir = join(home, ".config", "mise");
const defaultProfiles = ["pi-dev", "pi-ak", "pi-omp"];
const discovered = new Set(defaultProfiles);
const ompProfilesDir = join(home, ".omp", "profiles");
if (isDirectory(ompProfilesDir)) {
  let entries = [];
  try {
    entries = readdirSync(ompProfilesDir, { withFileTypes: true });
  } catch {}
  for (const entry of entries) {
    try {
      if (!entry.isDirectory()) continue;
      const id = entry.name;
      if (defaultProfiles.includes(id)) continue;
      const markerPath = join(ompProfilesDir, id, "agent", ".manager-profile");
      const marker = readRegular(markerPath);
      if (marker.exists && marker.regular && exactManagedFirstLine(marker.content)) {
        discovered.add(id);
      }
    } catch {}
  }
}
const profilesList = [];
const orderedProfiles = [
  ...defaultProfiles,
  ...Array.from(discovered).filter((id) => !defaultProfiles.includes(id)).sort(),
];
for (const id of orderedProfiles) {
  if (id === "pi-dev" || id === "pi-ak") {
    profilesList.push(piProfile(id));
  } else {
    profilesList.push(ompProfile(id));
  }
}
const profiles = profilesList.filter(Boolean);
process.stdout.write(`${JSON.stringify({ schemaVersion, profiles })}\n`);
NODE
}

install_pi_binary() {
