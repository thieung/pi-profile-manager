#!/usr/bin/env bash
set -euo pipefail

PROGRAM_NAME="pi-profile-manager"
PI_PACKAGE="@earendil-works/pi-coding-agent"
OMP_TOOL="github:can1357/oh-my-pi"
MISE_INSTALLER_URL="https://mise.run"
DRY_RUN=0
REQUESTED_VERSION="latest"

PI_EXTENSIONS=(
  "npm:statusline-pi@1.2.1"
  "npm:advisor-pi@1.0.3"
  "npm:grok-pi@1.2.0"
  "npm:model-debugger@1.0.2"
  "npm:@tintinweb/pi-subagents@0.18.0"
)

usage() {
  cat <<'USAGE'
Usage:
  pi-profile-manager bootstrap [--dry-run]
  pi-profile-manager doctor
  pi-profile-manager install <pi-dev|pi-ak|pi-omp|all> [--dry-run]
  pi-profile-manager update <pi|omp|all> [--version <exact>] [--dry-run]
  pi-profile-manager profiles list --json
  pi-profile-manager verify [pi-dev|pi-ak|pi-omp|all]

The script never reads or writes provider credentials. AgentKit is invoked only
for pi-ak and pi-omp. Bootstrap installs only Mise; Node.js/npm and AgentKit stay
explicit prerequisites. Use --dry-run to preview filesystem and command mutations.
USAGE
}

info() {
  printf 'INFO: %s\n' "$*"
}

warn() {
  printf 'WARN: %s\n' "$*" >&2
}

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

print_command() {
  printf 'RUN:'
  printf ' %q' "$@"
  printf '\n'
}

run_command() {
  print_command "$@"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    "$@"
  fi
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"
}

validate_version() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] \
    || fail "invalid version: $1"
}

timestamp() {
  date '+%Y%m%d-%H%M%S'
}

bootstrap_mise() {
  local install_path="$HOME/.local/bin/mise"
  local installer=""
  local staging_dir=""
  local staged_mise=""
  local mise_version=""

  if command -v mise >/dev/null 2>&1; then
    info "mise already available: $(command -v mise)"
    info "mise version: $(mise --version)"
    return
  fi

  if [[ -x "$install_path" ]]; then
    info "mise already installed: $install_path"
    info "mise version: $("$install_path" --version)"
    warn "$HOME/.local/bin is not currently in PATH"
    info "add to PATH: export PATH=\"$HOME/.local/bin:\$PATH\""
    return
  fi

  if [[ -e "$install_path" ]]; then
    fail "refusing to replace non-executable Mise path: $install_path"
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    info "would download official Mise installer: $MISE_INSTALLER_URL"
    info "would install Mise: $install_path"
    info "would verify: $install_path --version"
    return
  fi

  require_command curl
  require_command sh
  mkdir -p "$HOME/.local/bin"
  if ! installer="$(mktemp "${TMPDIR:-/tmp}/pi-profile-manager-mise.XXXXXX")"; then
    fail "failed to create temporary Mise installer"
  fi
  if ! staging_dir="$(mktemp -d "$HOME/.local/bin/.mise-stage.XXXXXX")"; then
    rm -f "$installer"
    fail "failed to create Mise staging directory"
  fi
  staged_mise="$staging_dir/mise"

  print_command curl --proto '=https' --tlsv1.2 --fail --silent \
    --show-error --location --output "$installer" "$MISE_INSTALLER_URL"
  if ! curl --proto '=https' --tlsv1.2 --fail --silent \
    --show-error --location --output "$installer" "$MISE_INSTALLER_URL"; then
    rm -f "$installer" "$staged_mise"
    rmdir "$staging_dir" 2>/dev/null || true
    fail "failed to download official Mise installer"
  fi

  print_command env "MISE_INSTALL_PATH=$staged_mise" \
    MISE_INSTALL_SKIP_IF_EXISTS=1 sh "$installer"
  if ! env "MISE_INSTALL_PATH=$staged_mise" \
    MISE_INSTALL_SKIP_IF_EXISTS=1 sh "$installer"; then
    rm -f "$installer" "$staged_mise"
    rmdir "$staging_dir" 2>/dev/null || true
    fail "official Mise installer failed"
  fi
  rm -f "$installer"

  if [[ ! -x "$staged_mise" ]]; then
    rm -f "$staged_mise"
    rmdir "$staging_dir" 2>/dev/null || true
    fail "Mise installer completed without executable staging binary"
  fi
  if ! mise_version="$("$staged_mise" --version)"; then
    rm -f "$staged_mise"
    rmdir "$staging_dir" 2>/dev/null || true
    fail "staged Mise binary failed verification"
  fi
  if ! mv "$staged_mise" "$install_path"; then
    rm -f "$staged_mise"
    rmdir "$staging_dir" 2>/dev/null || true
    fail "failed to promote staged Mise binary"
  fi
  rmdir "$staging_dir"
  info "mise installed: $install_path"
  info "mise version: $mise_version"
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) info "add to PATH: export PATH=\"$HOME/.local/bin:\$PATH\"" ;;
  esac
}

write_managed_file() {
  local path="$1"
  local content="$2"
  local current=""
  local backup=""

  if [[ -f "$path" ]]; then
    current="$(<"$path")"
    if [[ "$current" == "$content" ]]; then
      info "unchanged: $path"
      return
    fi
    if [[ "$DRY_RUN" -eq 1 ]]; then
      backup="${path}.bak.$(timestamp).XXXXXX"
      info "would back up: $path -> $backup"
    else
      backup="$(mktemp "${path}.bak.$(timestamp).XXXXXX")"
      cp -p "$path" "$backup"
      info "backed up: $path -> $backup"
    fi
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    info "would write: $path"
    return
  fi

  mkdir -p "$(dirname "$path")"
  printf '%s\n' "$content" >"$path"
  info "wrote: $path"
}

pi_root() {
  printf '%s/.pi/profiles/%s' "$HOME" "$1"
}

omp_root() {
  printf '%s/.omp/profiles/pi-omp/agent' "$HOME"
}

pi_config_content() {
  local profile="$1"
  printf '%s\n' \
    '[env]' \
    "PI_CODING_AGENT_DIR = \"{{ env.HOME }}/.pi/profiles/${profile}\"" \
    "PI_CODING_AGENT_SESSION_DIR = \"{{ env.HOME }}/.pi/profiles/${profile}/sessions\"" \
    'OMP_PROFILE = false' \
    'PI_PROFILE = false'
}

omp_config_content() {
  printf '%s\n' \
    '[env]' \
    'OMP_PROFILE = "pi-omp"' \
    'AGENTKIT_OMP_HOME = "{{ env.HOME }}/.omp/profiles/pi-omp/agent"' \
    'PI_PROFILE = false' \
    'PI_CODING_AGENT_DIR = false' \
    'PI_CODING_AGENT_SESSION_DIR = false'
}

wrapper_content() {
  local profile="$1"
  local executable="$2"
  printf '%s\n' \
    '#!/bin/sh' \
    "exec mise -E ${profile} exec -- ${executable} \"\$@\""
}

ensure_pi_profile() {
  local profile="$1"
  local root
  local config_path="$HOME/.config/mise/config.${profile}.toml"
  local wrapper_path="$HOME/.local/bin/${profile}"
  root="$(pi_root "$profile")"

  run_command mkdir -p "$root/sessions" "$HOME/.config/mise" "$HOME/.local/bin"
  write_managed_file "$config_path" "$(pi_config_content "$profile")"
  write_managed_file "$wrapper_path" "$(wrapper_content "$profile" pi)"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    chmod 0755 "$wrapper_path"
  else
    info "would chmod 0755: $wrapper_path"
  fi
}

ensure_omp_profile() {
  local root
  local config_path="$HOME/.config/mise/config.pi-omp.toml"
  local wrapper_path="$HOME/.local/bin/pi-omp"
  root="$(omp_root)"

  run_command mkdir -p "$root" "$HOME/.config/mise" "$HOME/.local/bin"
  write_managed_file "$config_path" "$(omp_config_content)"
  write_managed_file "$wrapper_path" "$(wrapper_content pi-omp omp)"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    chmod 0755 "$wrapper_path"
  else
    info "would chmod 0755: $wrapper_path"
  fi
}

assert_pi_profile_root() {
  local profile="$1"
  local expected
  local actual
  expected="$(pi_root "$profile")"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    info "would assert $profile root: $expected"
    return
  fi

  # Expansion is intentionally deferred to the profile-scoped child shell.
  # shellcheck disable=SC2016
  actual="$(mise -E "$profile" exec -- sh -c 'printf %s "$PI_CODING_AGENT_DIR"')"
  [[ "$actual" == "$expected" ]] \
    || fail "$profile resolved root '$actual'; expected '$expected'"
  [[ "$actual" != "$HOME/.pi/agent" ]] \
    || fail "$profile resolved to forbidden default root: $actual"
  info "$profile root verified: $actual"
}

assert_omp_profile_root() {
  local expected
  local values
  local actual_root
  local pi_value
  expected="$(omp_root)"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    info "would assert pi-omp root: $expected"
    return
  fi

  # Expansion is intentionally deferred to the profile-scoped child shell.
  # shellcheck disable=SC2016
  values="$(mise -E pi-omp exec -- sh -c 'printf "%s\n%s" "$AGENTKIT_OMP_HOME" "${PI_CODING_AGENT_DIR-unset}"')"
  actual_root="${values%%$'\n'*}"
  pi_value="${values#*$'\n'}"
  [[ "$actual_root" == "$expected" ]] \
    || fail "pi-omp resolved root '$actual_root'; expected '$expected'"
  [[ "$pi_value" == "unset" ]] \
    || fail "pi-omp unexpectedly inherits PI_CODING_AGENT_DIR='$pi_value'"
  info "pi-omp root verified: $actual_root"
}

profiles_list_json() {
  require_command node
  PPM_PROFILE_HOME="$HOME" node <<'NODE'
const { spawnSync } = require("node:child_process");
const { existsSync, lstatSync, readdirSync, readFileSync } = require("node:fs");
const { isAbsolute, join, resolve, relative, sep } = require("node:path");

const runtimeEnv = process["env"];
const home = runtimeEnv.PPM_PROFILE_HOME;
const schemaVersion = 1;

function warn(message) {
  process.stderr.write(`WARN: ${message}\n`);
}

function readRegular(path) {
  try {
    const stat = lstatSync(path);
    if (!stat.isFile()) return { exists: true, regular: false, content: "" };
    return { exists: true, regular: true, content: readFileSync(path, "utf8") };
  } catch (error) {
    if (error && error.code === "ENOENT") return { exists: false, regular: false, content: "" };
    throw error;
  }
}

function isDirectory(path) {
  try {
    return lstatSync(path).isDirectory();
  } catch (error) {
    if (error && error.code === "ENOENT") return false;
    throw error;
  }
}

function isExecutableFile(path) {
  try {
    const stat = lstatSync(path);
    return stat.isFile() && (stat.mode & 0o111) !== 0;
  } catch (error) {
    if (error && error.code === "ENOENT") return false;
    throw error;
  }
}

function piRoot(profile) {
  return join(home, ".pi", "profiles", profile);
}

function ompRoot() {
  return join(home, ".omp", "profiles", "pi-omp", "agent");
}

function piConfigContent(profile) {
  return [
    "[env]",
    `PI_CODING_AGENT_DIR = "{{ env.HOME }}/.pi/profiles/${profile}"`,
    `PI_CODING_AGENT_SESSION_DIR = "{{ env.HOME }}/.pi/profiles/${profile}/sessions"`,
    "OMP_PROFILE = false",
    "PI_PROFILE = false",
    "",
  ].join("\n");
}

function ompConfigContent() {
  return [
    "[env]",
    'OMP_PROFILE = "pi-omp"',
    'AGENTKIT_OMP_HOME = "{{ env.HOME }}/.omp/profiles/pi-omp/agent"',
    "PI_PROFILE = false",
    "PI_CODING_AGENT_DIR = false",
    "PI_CODING_AGENT_SESSION_DIR = false",
    "",
  ].join("\n");
}

function wrapperContent(profile, executable) {
  return [
    "#!/bin/sh",
    `exec mise -E ${profile} exec -- ${executable} "$@"`,
    "",
  ].join("\n");
}

function matchesManagedContent(actual, canonical) {
  return actual === canonical || actual === `${canonical}\n`;
}

function capture(profile, args, label) {
  const result = spawnSync(args[0], args.slice(1), {
    encoding: "utf8",
    env: runtimeEnv,
    stdio: ["ignore", "pipe", "pipe"],
  });
  if (result.error || result.status !== 0) {
    warn(`${profile} ${label} did not resolve`);
    return null;
  }
  return result.stdout.trim();
}

function piRuntimeHealthy(profile, agentDir, sessionDir) {
  const script = 'printf "%s\\n%s" "$PI_CODING_AGENT_DIR" "$PI_CODING_AGENT_SESSION_DIR"';
  const output = capture(profile, ["mise", "-E", profile, "exec", "--", "sh", "-c", script], "runtime environment");
  if (output === null) return false;
  const [actualAgentDir, actualSessionDir] = output.split("\n");
  return resolve(actualAgentDir || "") === resolve(agentDir) &&
    resolve(actualSessionDir || "") === resolve(sessionDir);
}

function ompRuntimeHealthy(agentDir) {
  const envScript = 'printf "%s\\n%s" "$AGENTKIT_OMP_HOME" "${PI_CODING_AGENT_DIR-unset}"';
  const output = capture("pi-omp", ["mise", "-E", "pi-omp", "exec", "--", "sh", "-c", envScript], "runtime environment");
  if (output === null) return false;
  const [actualAgentDir, piValue] = output.split("\n");
  if (resolve(actualAgentDir || "") !== resolve(agentDir) || piValue !== "unset") return false;
  const runtimeRoot = capture("pi-omp", ["mise", "-E", "pi-omp", "exec", "--", "omp", "config", "path"], "config path");
  return runtimeRoot !== null && resolve(runtimeRoot) === resolve(agentDir);
}

function readJsonObject(path, profile, label) {
  let stat;
  try {
    stat = lstatSync(path);
  } catch (error) {
    if (error && error.code === "ENOENT") return null;
    throw error;
  }
  if (!stat.isFile()) {
    warn(`${profile} AgentKit ${label} is not a regular file`);
    return null;
  }
  const content = readFileSync(path, "utf8");
  try {
    const value = JSON.parse(content);
    if (!value || Array.isArray(value) || typeof value !== "object") {
      warn(`${profile} AgentKit ${label} is not a JSON object`);
      return null;
    }
    return value;
  } catch {
    warn(`${profile} AgentKit ${label} is invalid`);
    return null;
  }
}

function piAgentKitEnabled(profile, agentDir) {
  const manifest = readJsonObject(
    join(agentDir, "extensions", "agentkit-hooks-engineer", ".agentkit", "install-manifest.json"),
    profile,
    "manifest",
  );
  return Boolean(manifest && manifest.version === 1 && manifest.kit === "engineer" && Array.isArray(manifest.files));
}

function hasAkSkills(root) {
  const skillsRoot = join(root, "skills");
  try {
    return readdirSync(skillsRoot, { withFileTypes: true }).some((entry) =>
      entry.isDirectory() && entry.name.startsWith("ak-") && existsSync(join(skillsRoot, entry.name, "SKILL.md")),
    );
  } catch (error) {
    if (error && error.code === "ENOENT") return false;
    throw error;
  }
}

function isUnderRoot(path, root) {
  const rel = relative(resolve(root), resolve(path));
  return rel === "" || (!rel.startsWith("..") && rel !== ".." && !rel.startsWith(`..${sep}`));
}

function collectStrings(value, output = []) {
  if (typeof value === "string") output.push(value);
  else if (Array.isArray(value)) value.forEach((entry) => collectStrings(entry, output));
  else if (value && typeof value === "object") Object.values(value).forEach((entry) => collectStrings(entry, output));
  return output;
}

function hasWrongOmpClaims(value, root) {
  if (!value) return false;
  for (const text of collectStrings(value)) {
    const normalized = text.replaceAll("\\\\", "/");
    const pathClaim = isAbsolute(text) || normalized.includes("/.omp/") || normalized.includes(":/.omp/");
    if (!pathClaim) continue;
    if (!isUnderRoot(text, root)) return true;
  }
  return false;
}

function ompClaimsStayInProfile(root) {
  const ownership = readJsonObject(
    join(home, ".agentkit", "adapters", "omp", "engineer", "omp-ownership.json"),
    "pi-omp",
    "ownership",
  );
  const nativePaths = readJsonObject(
    join(home, ".agentkit", "adapters", "omp", "engineer", ".agentkit", "native-skill-paths.json"),
    "pi-omp",
    "native skill paths",
  );
  if (hasWrongOmpClaims(ownership, root) || hasWrongOmpClaims(nativePaths, root)) return false;
  return !ownership || (ownership.version === 1 && ownership.kit === "engineer" && Array.isArray(ownership.claims));
}

function ompAgentKitEnabled() {
  const root = ompRoot();
  return hasAkSkills(root) && ompClaimsStayInProfile(root);
}

function piProfile(profile) {
  const agentDir = piRoot(profile);
  const sessionDir = join(agentDir, "sessions");
  const configPath = join(home, ".config", "mise", `config.${profile}.toml`);
  const wrapperPath = join(home, ".local", "bin", profile);
  const config = readRegular(configPath);
  const wrapper = readRegular(wrapperPath);
  if (!config.exists && !wrapper.exists) return null;
  const managed = config.regular && wrapper.regular &&
    matchesManagedContent(config.content, piConfigContent(profile)) &&
    matchesManagedContent(wrapper.content, wrapperContent(profile, "pi"));
  if (!managed) warn(`${profile} managed evidence is incomplete or drifted`);
  const runtimeHealthy = managed && piRuntimeHealthy(profile, agentDir, sessionDir);
  const healthy = managed && isDirectory(agentDir) && isDirectory(sessionDir) &&
    isExecutableFile(wrapperPath) && runtimeHealthy;
  return {
    id: profile,
    runtime: "pi",
    agentDir: resolve(agentDir),
    sessionDir: resolve(sessionDir),
    agentkitEnabled: piAgentKitEnabled(profile, agentDir),
    managed,
    healthy,
  };
}

function ompProfile() {
  const agentDir = ompRoot();
  const configPath = join(home, ".config", "mise", "config.pi-omp.toml");
  const wrapperPath = join(home, ".local", "bin", "pi-omp");
  const config = readRegular(configPath);
  const wrapper = readRegular(wrapperPath);
  if (!config.exists && !wrapper.exists) return null;
  const managed = config.regular && wrapper.regular &&
    matchesManagedContent(config.content, ompConfigContent()) &&
    matchesManagedContent(wrapper.content, wrapperContent("pi-omp", "omp"));
  if (!managed) warn("pi-omp managed evidence is incomplete or drifted");
  const runtimeHealthy = managed && ompRuntimeHealthy(agentDir);
  return {
    id: "pi-omp",
    runtime: "omp",
    agentDir: resolve(agentDir),
    sessionDir: null,
    agentkitEnabled: ompAgentKitEnabled(),
    managed,
    healthy: managed && isDirectory(agentDir) && isExecutableFile(wrapperPath) && runtimeHealthy,
  };
}

const profiles = [piProfile("pi-dev"), piProfile("pi-ak"), ompProfile()].filter(Boolean);
process.stdout.write(`${JSON.stringify({ schemaVersion, profiles })}\n`);
NODE
}

install_pi_binary() {
  local version="$1"
  require_command npm
  validate_version "$version"
  run_command npm install -g --ignore-scripts "${PI_PACKAGE}@${version}"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    require_command pi
    info "Pi installed: $(pi --version)"
  fi
}

resolve_omp_version() {
  local version="$1"
  if [[ "$DRY_RUN" -eq 1 && "$version" == "latest" ]]; then
    printf '%s\n' "latest"
    return
  fi
  if [[ "$version" == "latest" ]]; then
    mise latest "$OMP_TOOL"
  else
    printf '%s\n' "$version"
  fi
}

install_omp_binary() {
  local version="$1"
  local resolved
  require_command mise
  validate_version "$version"
  resolved="$(resolve_omp_version "$version")"
  validate_version "$resolved"
  if [[ "$DRY_RUN" -eq 1 && "$version" == "latest" ]]; then
    info "OMP target version: latest (not resolved during dry-run)"
  else
    info "OMP target version: $resolved"
  fi
  run_command env MISE_LOCKED=0 mise use -g --pin "${OMP_TOOL}@${resolved}"
  run_command mise lock -g "$OMP_TOOL"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    require_command omp
    info "OMP installed: $(omp --version)"
  fi
}

install_pi_extensions() {
  local profile="$1"
  local extension=""
  local wrapper="$HOME/.local/bin/$profile"
  assert_pi_profile_root "$profile"
  for extension in "${PI_EXTENSIONS[@]}"; do
    run_command "$wrapper" install "$extension"
  done
}

omp_agentkit_check() {
  local root
  root="$(omp_root)"
  PPM_PROFILE_HOME="$HOME" node <<'NODE'
const { existsSync, lstatSync, readdirSync, readFileSync } = require("node:fs");
const { isAbsolute, join, relative, resolve, sep } = require("node:path");

const home = process.env.PPM_PROFILE_HOME;
const root = join(home, ".omp", "profiles", "pi-omp", "agent");
const defaultRoot = join(home, ".omp", "agent");
const skillsRoot = join(root, "skills");

function fail(message) {
  process.stderr.write(`ERROR: ${message}\n`);
  process.exit(1);
}
function isUnder(path, expectedRoot) {
  const rel = relative(resolve(expectedRoot), resolve(path));
  return rel === "" || (!rel.startsWith("..") && rel !== ".." && !rel.startsWith(`..${sep}`));
}
function readJson(path) {
  try {
    if (!lstatSync(path).isFile()) return null;
    return JSON.parse(readFileSync(path, "utf8"));
  } catch (error) {
    if (error && error.code === "ENOENT") return null;
    fail(`pi-omp AgentKit evidence is unreadable: ${path}`);
  }
}
function collectStrings(value, output = []) {
  if (typeof value === "string") output.push(value);
  else if (Array.isArray(value)) value.forEach((entry) => collectStrings(entry, output));
  else if (value && typeof value === "object") Object.values(value).forEach((entry) => collectStrings(entry, output));
  return output;
}
function firstWrongClaim(value) {
  if (!value) return null;
  for (const text of collectStrings(value)) {
    const normalized = text.replaceAll("\\\\", "/");
    const pathClaim = isAbsolute(text) || normalized.includes("/.omp/") || normalized.includes(":/.omp/");
    if (!pathClaim || isUnder(text, root)) continue;
    return text;
  }
  return null;
}
function firstAkSkill() {
  try {
    for (const entry of readdirSync(skillsRoot, { withFileTypes: true })) {
      const skill = join(skillsRoot, entry.name, "SKILL.md");
      if (entry.isDirectory() && entry.name.startsWith("ak-") && existsSync(skill)) return skill;
    }
  } catch (error) {
    if (!error || error.code !== "ENOENT") throw error;
  }
  return null;
}
const ownershipPath = join(home, ".agentkit", "adapters", "omp", "engineer", "omp-ownership.json");
const nativePathsPath = join(home, ".agentkit", "adapters", "omp", "engineer", ".agentkit", "native-skill-paths.json");
const wrongClaim = firstWrongClaim(readJson(ownershipPath)) || firstWrongClaim(readJson(nativePathsPath));
const skill = firstAkSkill();
if (wrongClaim || !skill) {
  const defaultSkills = join(defaultRoot, "skills");
  const found = skill || (existsSync(defaultSkills) ? defaultSkills : "none");
  fail([
    "pi-omp AgentKit skills were not installed into the named OMP profile.",
    `AGENTKIT_OMP_HOME=${root}`,
    `actual skills root found=${found}`,
    `wrong default destination=${defaultSkills}`,
    wrongClaim ? `out-of-profile claim=${wrongClaim}` : null,
    "repair: re-run pi-profile-manager install pi-omp",
  ].filter(Boolean).join(" "));
}
process.stdout.write(`${skill}\n`);
NODE
}

install_agentkit() {
  local profile="$1"
  local target="$2"
  require_command ak
  if [[ "$target" == "pi" ]]; then
    assert_pi_profile_root "$profile"
  else
    assert_omp_profile_root
  fi
  run_command mise -E "$profile" exec -- \
    ak kit init engineer \
    --target "$target" \
    --global \
    --channel beta \
    --yes \
    --no-interactive
  if [[ "$target" == "omp" ]]; then
    if [[ "$DRY_RUN" -eq 1 ]]; then
      info "would assert AgentKit skills under: $(omp_root)/skills/ak-*/SKILL.md"
      info "would reject default OMP AgentKit destination: $HOME/.omp/agent/skills"
    else
      local found_skill
      found_skill="$(omp_agentkit_check)"
      info "pi-omp AgentKit skill verified: $found_skill"
    fi
  fi
}

preflight_install() {
  local target="$1"
  require_command mise
  case "$target" in
    pi-dev)
      require_command npm
      ;;
    pi-ak)
      require_command npm
      require_command ak
      ;;
    pi-omp)
      require_command ak
      ;;
    all)
      require_command npm
      require_command ak
      ;;
    *)
      fail "unknown install target: $target"
      ;;
  esac
}

prepare_install_target() {
  local target="$1"

  case "$target" in
    pi-dev)
      ensure_pi_profile pi-dev
      assert_pi_profile_root pi-dev
      ;;
    pi-ak)
      ensure_pi_profile pi-ak
      assert_pi_profile_root pi-ak
      ;;
    pi-omp)
      ensure_omp_profile
      assert_omp_profile_root
      ;;
    all)
      ensure_pi_profile pi-dev
      ensure_pi_profile pi-ak
      ensure_omp_profile
      assert_pi_profile_root pi-dev
      assert_pi_profile_root pi-ak
      assert_omp_profile_root
      ;;
  esac
}

install_target() {
  local target="$1"
  preflight_install "$target"
  prepare_install_target "$target"

  case "$target" in
    pi-dev)
      install_pi_binary latest
      install_pi_extensions pi-dev
      ;;
    pi-ak)
      install_pi_binary latest
      install_pi_extensions pi-ak
      install_agentkit pi-ak pi
      ;;
    pi-omp)
      install_omp_binary latest
      install_agentkit pi-omp omp
      ;;
    all)
      install_pi_binary latest
      install_pi_extensions pi-dev
      install_pi_extensions pi-ak
      install_agentkit pi-ak pi
      install_omp_binary latest
      install_agentkit pi-omp omp
      ;;
  esac

  info "install complete: $target"
  info "next: $PROGRAM_NAME verify $target"
}

update_pi() {
  assert_installed_pi_profiles_for_update
  install_pi_binary "$REQUESTED_VERSION"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    [[ ! -x "$HOME/.local/bin/pi-dev" ]] || info "pi-dev: $("$HOME/.local/bin/pi-dev" --version)"
    [[ ! -x "$HOME/.local/bin/pi-ak" ]] || info "pi-ak: $("$HOME/.local/bin/pi-ak" --version)"
  fi
}

update_omp() {
  assert_installed_omp_profile_for_update
  install_omp_binary "$REQUESTED_VERSION"
  if [[ "$DRY_RUN" -eq 0 && -x "$HOME/.local/bin/pi-omp" ]]; then
    info "pi-omp: $("$HOME/.local/bin/pi-omp" --version)"
  fi
}

assert_installed_pi_profiles_for_update() {
  local profile=""
  local config_path=""
  local wrapper_path=""
  local found=0

  for profile in pi-dev pi-ak; do
    config_path="$HOME/.config/mise/config.${profile}.toml"
    wrapper_path="$HOME/.local/bin/${profile}"
    if [[ -e "$config_path" || -e "$wrapper_path" ]]; then
      [[ -f "$config_path" ]] || fail "$profile update requires config: $config_path"
      [[ -x "$wrapper_path" ]] || fail "$profile update requires executable wrapper: $wrapper_path"
      assert_pi_profile_root "$profile"
      found=1
    fi
  done

  [[ "$found" -eq 1 ]] \
    || fail "no managed Pi profile found; run install pi-dev or install pi-ak first"
}

assert_installed_omp_profile_for_update() {
  local config_path="$HOME/.config/mise/config.pi-omp.toml"
  local wrapper_path="$HOME/.local/bin/pi-omp"

  [[ -f "$config_path" ]] || fail "pi-omp update requires config: $config_path"
  [[ -x "$wrapper_path" ]] || fail "pi-omp update requires executable wrapper: $wrapper_path"
  assert_omp_profile_root
}

update_target() {
  local target="$1"
  case "$target" in
    pi)
      require_command mise
      require_command npm
      update_pi
      ;;
    omp)
      require_command mise
      update_omp
      ;;
    all)
      [[ "$REQUESTED_VERSION" == "latest" ]] \
        || fail "--version cannot be combined with update all"
      require_command mise
      require_command npm
      assert_installed_pi_profiles_for_update
      assert_installed_omp_profile_for_update
      update_pi
      update_omp
      ;;
    *)
      fail "unknown update target: $target"
      ;;
  esac
}

verify_pi_profile() {
  local profile="$1"
  local root
  local wrapper="$HOME/.local/bin/$profile"
  local packages
  local extension=""
  root="$(pi_root "$profile")"

  [[ -x "$wrapper" ]] || fail "missing executable wrapper: $wrapper"
  assert_pi_profile_root "$profile"
  packages="$("$wrapper" list)"
  for extension in "${PI_EXTENSIONS[@]}"; do
    grep -F "$extension" <<<"$packages" >/dev/null \
      || fail "$profile missing extension: $extension"
  done
  grep -F "$root/npm/node_modules" <<<"$packages" >/dev/null \
    || fail "$profile package list does not point to its profile root"

  if [[ "$profile" == "pi-ak" ]]; then
    [[ -f "$root/extensions/agentkit-hooks-engineer/.agentkit/install-manifest.json" ]] \
      || fail "pi-ak missing AgentKit install manifest"
  fi
  info "$profile verification passed"
}

verify_omp_profile() {
  local root
  local wrapper="$HOME/.local/bin/pi-omp"
  local runtime_root
  root="$(omp_root)"

  [[ -x "$wrapper" ]] || fail "missing executable wrapper: $wrapper"
  assert_omp_profile_root
  runtime_root="$("$wrapper" config path)"
  [[ "$runtime_root" == "$root" ]] \
    || fail "pi-omp config path '$runtime_root'; expected '$root'"
  omp_agentkit_check >/dev/null
  info "pi-omp verification passed"
}

verify_target() {
  local target="$1"
  require_command mise
  case "$target" in
    pi-dev)
      verify_pi_profile pi-dev
      ;;
    pi-ak)
      verify_pi_profile pi-ak
      ;;
    pi-omp)
      verify_omp_profile
      ;;
    all)
      verify_pi_profile pi-dev
      verify_pi_profile pi-ak
      verify_omp_profile
      ;;
    *)
      fail "unknown verify target: $target"
      ;;
  esac
}

doctor() {
  local failures=0
  local command_name=""
  for command_name in mise npm; do
    if command -v "$command_name" >/dev/null 2>&1; then
      info "$command_name: $(command -v "$command_name")"
    else
      warn "missing prerequisite: $command_name"
      failures=$((failures + 1))
    fi
  done

  for command_name in pi omp ak; do
    if command -v "$command_name" >/dev/null 2>&1; then
      info "$command_name: $(command -v "$command_name")"
    else
      warn "optional until its profile is installed: $command_name"
    fi
  done

  case ":$PATH:" in
    *":$HOME/.local/bin:"*) info "wrapper PATH configured: $HOME/.local/bin" ;;
    *) warn "$HOME/.local/bin is not currently in PATH" ;;
  esac

  [[ "$failures" -eq 0 ]] || fail "doctor found $failures missing prerequisite(s)"
  info "doctor passed"
}

parse_options() {
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      --version)
        [[ "$#" -ge 2 ]] || fail "--version requires a value"
        REQUESTED_VERSION="$2"
        validate_version "$REQUESTED_VERSION"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        fail "unknown option: $1"
        ;;
    esac
  done
}

main() {
  local command="${1:-}"
  local target=""
  [[ -n "$command" ]] || {
    usage
    exit 1
  }
  shift || true

  case "$command" in
    bootstrap)
      parse_options "$@"
      [[ "$REQUESTED_VERSION" == "latest" ]] \
        || fail "bootstrap does not accept --version"
      bootstrap_mise
      ;;
    doctor)
      [[ "$#" -eq 0 ]] || fail "doctor does not accept arguments"
      doctor
      ;;
    install)
      target="${1:-}"
      [[ -n "$target" ]] || fail "install requires a profile or all"
      shift
      parse_options "$@"
      [[ "$REQUESTED_VERSION" == "latest" ]] \
        || fail "--version is supported only by update"
      install_target "$target"
      ;;
    update)
      target="${1:-}"
      [[ -n "$target" ]] || fail "update requires pi, omp, or all"
      shift
      parse_options "$@"
      update_target "$target"
      ;;
    profiles)
      target="${1:-}"
      [[ "$target" == "list" ]] || fail "profiles requires: list --json"
      shift
      [[ "${1:-}" == "--json" && "$#" -eq 1 ]] || fail "profiles list requires --json"
      profiles_list_json
      ;;
    verify)
      target="${1:-all}"
      [[ "$#" -le 1 ]] || fail "verify accepts at most one target"
      verify_target "$target"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      usage >&2
      fail "unknown command: $command"
      ;;
  esac
}

main "$@"
