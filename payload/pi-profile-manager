omp_agentkit_check() {
  local profile="${1:-pi-omp}"
  local root
  root="$(omp_root "$profile")"
  PPM_TARGET_PROFILE="$profile" PPM_PROFILE_HOME="$HOME" node <<'NODE'
const { existsSync, lstatSync, readdirSync, readFileSync } = require("node:fs");
const { isAbsolute, join, relative, resolve, sep } = require("node:path");

const home = process.env.PPM_PROFILE_HOME;
const profile = process.env.PPM_TARGET_PROFILE || "pi-omp";
const root = join(home, ".omp", "profiles", profile, "agent");
const defaultRoot = join(home, ".omp", "agent");
const skillsRoot = join(root, "skills");

function fail(message) {
  process.stderr.write(`ERROR: ${message}\n`);
  process.exit(1);
}
function isUnder(path, expectedRoot) {
  const rel = relative(resolve(expectedRoot), resolve(path));
  return rel === "" || (!isAbsolute(rel) && !rel.startsWith("..") && rel !== ".." && !rel.startsWith(`..${sep}`));
}
function readJson(path) {
  try {
    if (!lstatSync(path).isFile()) return null;
    return JSON.parse(readFileSync(path, "utf8"));
  } catch (error) {
    if (error && error.code === "ENOENT") return null;
    fail(`${profile} AgentKit evidence is unreadable: ${path}`);
  }
}
function collectStrings(value, output = []) {
  if (typeof value === "string") output.push(value);
  else if (Array.isArray(value)) value.forEach((entry) => collectStrings(entry, output));
  else if (value && typeof value === "object") Object.values(value).forEach((entry) => collectStrings(entry, output));
  return output;
}
function isOmpPathClaim(text) {
  const normalized = String(text).replaceAll("\\", "/");
  return isAbsolute(text) || normalized.includes("/.omp/") || normalized.includes(":/.omp/");
}
function firstWrongClaim(value) {
  if (!value) return null;
  const profilesRoot = join(home, ".omp", "profiles");
  for (const text of collectStrings(value)) {
    if (!isOmpPathClaim(text)) continue;
    if (isUnder(text, defaultRoot) || !isUnder(text, profilesRoot)) return text;
  }
  return null;
}
function hasTargetClaim(value) {
  if (!value) return false;
  for (const text of collectStrings(value)) {
    if (isOmpPathClaim(text) && isUnder(text, root)) return true;
  }
  return false;
}
function validOwnership(value) {
  return Boolean(value && value.version === 1 && value.kit === "engineer" && Array.isArray(value.claims));
}
function validNativePaths(value) {
  return Boolean(value && Array.isArray(value.skills));
}
function firstAkSkill() {
  try {
    for (const entry of readdirSync(skillsRoot, { withFileTypes: true })) {
      const skill = join(skillsRoot, entry.name, "SKILL.md");
      if (entry.isDirectory() && entry.name.startsWith("ak-") && existsSync(skill)) return skill;
    }
  } catch (error) {
    if (!error || error.code !== "ENOENT") throw error;
  }
  return null;
}
const ownershipPath = join(home, ".agentkit", "adapters", "omp", "engineer", "omp-ownership.json");
const nativePathsPath = join(home, ".agentkit", "adapters", "omp", "engineer", ".agentkit", "native-skill-paths.json");
const ownership = readJson(ownershipPath);
const nativePaths = readJson(nativePathsPath);
const wrongClaim = firstWrongClaim(ownership) || firstWrongClaim(nativePaths);
const skill = firstAkSkill();
const missingTarget = !hasTargetClaim(ownership && ownership.claims) || !hasTargetClaim(nativePaths && nativePaths.skills);
if (wrongClaim || !skill || !validOwnership(ownership) || !validNativePaths(nativePaths) || missingTarget) {
  const defaultSkills = join(defaultRoot, "skills");
  const found = skill || (existsSync(defaultSkills) ? defaultSkills : "none");
  fail([
    `${profile} AgentKit skills were not installed into the named OMP profile.`,
    `AGENTKIT_OMP_HOME=${root}`,
    `actual skills root found=${found}`,
    `wrong default destination=${defaultSkills}`,
    wrongClaim ? `out-of-profile claim=${wrongClaim}` : null,
    !validOwnership(ownership) ? (ownership ? "malformed AgentKit ownership metadata" : "missing AgentKit ownership metadata") : null,
    !validNativePaths(nativePaths) ? (nativePaths ? "malformed AgentKit native skill paths" : "missing AgentKit native skill paths") : null,
    !wrongClaim && missingTarget ? "missing in-profile AgentKit claim" : null,
    `repair: re-run pi-profile-manager install ${profile}`,
  ].filter(Boolean).join(" "));
}
process.stdout.write(`${skill}\n`);
NODE
}

install_agentkit() {
  local profile="$1"
  local target="$2"
  require_command ak
  if [[ "$target" == "pi" ]]; then
    assert_pi_profile_root "$profile"
  else
    assert_omp_profile_root "$profile"
  fi
  run_command mise -E "$profile" exec -- \
    ak kit init engineer \
    --target "$target" \
    --global \
    --channel beta \
    --yes \
    --no-interactive
  if [[ "$target" == "omp" ]]; then
    if [[ "$DRY_RUN" -eq 1 ]]; then
      info "would assert AgentKit skills under: $(omp_root "$profile")/skills/ak-*/SKILL.md"
      info "would reject default OMP AgentKit destination: $HOME/.omp/agent/skills"
